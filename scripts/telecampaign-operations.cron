SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# TeleCampaign only: daily protected PostgreSQL dump, frequent local health check,
# and bounded rotation of the dedicated PM2 logs without stopping the API.
17 2 * * * root /opt/telecampaign/scripts/backup-telecampaign.sh >> /var/log/telecampaign-backup.log 2>&1
*/5 * * * * root /opt/telecampaign/scripts/telecampaign-healthcheck.sh >> /var/log/telecampaign-health.log 2>&1
*/5 * * * * root /usr/sbin/logrotate -s /var/lib/telecampaign/telecampaign-logrotate.status /etc/logrotate.d/telecampaign-api >/dev/null 2>&1